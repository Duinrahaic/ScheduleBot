# Required Discord bot token
DISCORD_BOT_TOKEN=
DISCORD_EVENT_ROLE_PREFIX=EventRole
LOG_LEVEL=info
HEALTH_PORT=3000

# SQLite (default, no database server required)
DATABASE_TYPE=sqlite
SQLITE_FILE=./data/schedulebot.sqlite3

# MySQL (set DATABASE_TYPE=mysql). Legacy names remain supported.
MYSQL_SERVER=db
MYSQL_PORT=3306
MYSQL_DB=ScheduleBot
MYSQL_USER=schedulebot
MYSQL_USER_PW=replace-with-a-strong-password
# Compose asks MySQL to generate a random root password.
# Alternatively accepts mysql://... or legacy aliases such as
# Data Source=...;User Id=...;Pwd=...;Initial Catalog=...
# DISCORD_BOT_CONNECTION_STRING=

SCHEDULER_INTERVAL_MS=60000
SCHEDULER_LEAD_MINUTES=60
CLEANUP_DELAY_MINUTES=60
